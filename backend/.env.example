# Copy this file to .env and fill in your values for local development
# On Railway, set these in the Dashboard → Variables tab

# ── AI ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── DATABASE ─────────────────────────────────────────────────────
# Railway injects this automatically when you add a PostgreSQL plugin.
# For local dev, leave blank to use SQLite.
DATABASE_URL=

# ── JWT SECRETS ───────────────────────────────────────────────────
# Generate strong random values: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_string
JWT_REFRESH_SECRET_KEY=change_me_to_another_random_64_char_string

# ── CORS ──────────────────────────────────────────────────────────
# Set to your Vercel frontend URL after deploying frontend.
# e.g. https://nova-resume-ai.vercel.app
FRONTEND_URL=*
